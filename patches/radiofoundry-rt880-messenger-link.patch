+		msg_bridge_on_rx(pkt, (int8_t)(last_rssi < -128 ? -128 : last_rssi));
+		store = msg_bridge_local_store();
+		auto_ack = !msg_bridge_suppress_auto_ack();
+#endif
 		if (msg_rx.type == MSG_PKT_TYPE_TEXT) {
 			// A text message: file it in the inbox (which also refreshes HEARD), flag the UI to pop it up, and
 			// queue an ACK back to the sender so they see it was delivered.
-			msg_store_add_inbox(msg_rx.from, (const char *)msg_rx.payload, msg_rx.type, last_rssi);
-			msg_rx_new = true;
-			unsigned i = 0;
-			for (; msg_rx.from[i] && i < MSG_CALLSIGN_LEN; i++) {
-				msg_ack_to[i] = msg_rx.from[i];
+			if (store) {
+				msg_store_add_inbox(msg_rx.from, (const char *)msg_rx.payload, msg_rx.type, last_rssi);
+				msg_rx_new = true;
+			}
+			if (auto_ack) {
+				unsigned i = 0;
+				for (; msg_rx.from[i] && i < MSG_CALLSIGN_LEN; i++) {
+					msg_ack_to[i] = msg_rx.from[i];
+				}
+				msg_ack_to[i] = '\0';
+				msg_ack_id = msg_rx.id;
+				msg_ack_pending = true;
 			}
-			msg_ack_to[i] = '\0';
-			msg_ack_id = msg_rx.id;
-			msg_ack_pending = true;
 		} else if (msg_rx.type == MSG_PKT_TYPE_ACK) {
 			// An ACK for one of our messages: mark it delivered. Still refresh HEARD for the station.
 			msg_store_ack(msg_rx.id);
diff --git a/core/messenger/msg_bridge.c b/core/messenger/msg_bridge.c
new file mode 100644
index 0000000..7a41cda
--- /dev/null
+++ b/core/messenger/msg_bridge.c
@@ -0,0 +1,262 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 The RadioFoundry Authors
+// The radio's side of the messenger link (msg_bridge.h).
+#include <string.h>
+#include "messenger/msg_bridge.h"
+#include "messenger/msg_link.h"
+#include "messenger/msg_kiss.h"
+
+static msg_bridge_ops_t ops;
+static msg_kiss_rx_t rx;
+static char own_call[MSG_CALLSIGN_LEN + 1];
+static bool attached;
+static uint8_t mode = MSG_LINK_MODE_DEFAULT;
+static uint32_t last_host_ms;
+static uint16_t dropped;
+
+// Output queue: a byte ring of whole encoded frames plus an index of their lengths. A producer appends a frame only
+// when all of it fits; output() hands out only whole frames that fit its buffer, so frames from the link task and the
+// radio task never interleave on the wire.
+#define OUT_FRAMES_MAX	16u
+static uint8_t out_ring[MSG_BRIDGE_OUT_BYTES];
+static uint16_t out_head, out_tail, out_used;		// bytes
+static uint16_t frame_len[OUT_FRAMES_MAX];		// lengths of the queued frames, oldest first
+static uint8_t frame_head, frame_count;
+
+static void lock(void)
+{
+	if (ops.lock != NULL) {
+		ops.lock(ops.ctx);
+	}
+}
+
+static void unlock(void)
+{
+	if (ops.unlock != NULL) {
+		ops.unlock(ops.ctx);
+	}
+}
+
+// Append one encoded frame. Caller holds the lock. False (and counted) when it doesn't fit.
+static bool out_push(const uint8_t *bytes, size_t n)
+{
+	if (n == 0 || n > MSG_BRIDGE_OUT_BYTES - out_used || frame_count >= OUT_FRAMES_MAX) {
+		dropped++;
+		return false;
+	}
+	for (size_t i = 0; i < n; i++) {
+		out_ring[out_tail] = bytes[i];
+		out_tail = (uint16_t)((out_tail + 1u) % MSG_BRIDGE_OUT_BYTES);
+	}
+	out_used = (uint16_t)(out_used + n);
+	frame_len[(frame_head + frame_count) % OUT_FRAMES_MAX] = (uint16_t)n;
+	frame_count++;
+	return true;
+}
+
+static void send_ctrl(uint8_t op, const uint8_t *data, size_t len)
+{
+	uint8_t enc[MSG_LINK_FRAME_MAX];
+	size_t n = msg_kiss_encode(enc, sizeof enc, MSG_LINK_CMD_CTRL, &op, 1, data, len);
+	lock();
+	(void)out_push(enc, n);
+	unlock();
+}
+
+static void send_error(uint8_t op, uint8_t err)
+{
+	uint8_t d[2] = { op, err };
+	send_ctrl(MSG_LINK_EV_ERROR, d, sizeof d);
+}
+
+static void send_hello_reply(void)
+{
+	uint8_t d[3 + MSG_CALLSIGN_LEN];
+	memset(d, 0, sizeof d);
+	d[0] = MSG_LINK_VERSION;
+	d[1] = mode;
+	d[2] = (ops.caps != NULL) ? ops.caps(ops.ctx) : MSG_LINK_CAP_TX;
+	memcpy(&d[3], own_call, strlen(own_call));
+	send_ctrl(MSG_LINK_EV_HELLO, d, sizeof d);
+}
+
+void msg_bridge_init(const msg_bridge_ops_t *o, const char *call)
+{
+	memset(&ops, 0, sizeof ops);
+	if (o != NULL) {
+		ops = *o;
+	}
+	msg_kiss_rx_init(&rx);
+	memset(own_call, 0, sizeof own_call);
+	for (unsigned i = 0; call != NULL && call[i] != '\0' && i < MSG_CALLSIGN_LEN; i++) {
+		own_call[i] = call[i];
+	}
+	attached = false;
+	mode = MSG_LINK_MODE_DEFAULT;
+	last_host_ms = 0;
+	dropped = 0;
+	out_head = out_tail = out_used = 0;
+	frame_head = frame_count = 0;
+}
+
+bool msg_bridge_claims(uint8_t b)
+{
+	return b == MSG_KISS_FEND;
+}
+
+static void on_data(const uint8_t *d, uint16_t n)
+{
+	msg_packet_t p;
+	if (n != MSG_PKT_WIRE_LEN || !msg_packet_parse(d, (uint8_t)n, &p)) {
+		send_error(MSG_LINK_CMD_DATA, MSG_LINK_ERR_BAD_PACKET);
+		return;
+	}
+	if (ops.tx_packet == NULL || !ops.tx_packet(ops.ctx, d)) {
+		uint8_t r[4] = { p.type, (uint8_t)(p.id & 0xFFu), (uint8_t)(p.id >> 8), MSG_LINK_TX_QUEUE_FULL };
+		send_ctrl(MSG_LINK_EV_TX_RESULT, r, sizeof r);
+	}
+}
+
+static void on_ctrl(const uint8_t *d, uint16_t n)
+{
+	if (n < 1u) {
+		return;
+	}
+	uint8_t op = d[0];
+	const uint8_t *a = &d[1];
+	uint16_t an = (uint16_t)(n - 1u);
+	switch (op) {
+	case MSG_LINK_OP_HELLO:
+		mode = MSG_LINK_MODE_DEFAULT;
+		attached = true;
+		send_hello_reply();
+		break;
+	case MSG_LINK_OP_SET_CALL:
+		if (an < 1u || an > MSG_CALLSIGN_LEN) {
+			send_error(op, MSG_LINK_ERR_BAD_LEN);
+			break;
+		}
+		memset(own_call, 0, sizeof own_call);
+		memcpy(own_call, a, an);
+		if (ops.set_call != NULL) {
+			ops.set_call(ops.ctx, own_call);
+		}
+		break;
+	case MSG_LINK_OP_KEEPALIVE:
+		break;
+	case MSG_LINK_OP_SET_MODE:
+		if (an != 1u) {
+			send_error(op, MSG_LINK_ERR_BAD_LEN);
+			break;
+		}
+		mode = a[0];
+		send_hello_reply();
+		break;
+	default:
+		send_error(op, MSG_LINK_ERR_BAD_OP);
+		break;
+	}
+}
+
+static void on_frame(const uint8_t *f, uint16_t len, uint32_t now_ms)
+{
+	if ((f[0] >> 4) != MSG_LINK_PORT) {
+		return;				// another KISS port: not ours
+	}
+	last_host_ms = now_ms;
+	if (f[0] == MSG_LINK_CMD_DATA) {
+		if (!attached) {
+			attached = true;	// a host that transmits without HELLO still gets bridge semantics
+		}
+		on_data(&f[1], (uint16_t)(len - 1u));
+	} else if (f[0] == MSG_LINK_CMD_CTRL) {
+		on_ctrl(&f[1], (uint16_t)(len - 1u));
+	}
+}
+
+void msg_bridge_feed(const uint8_t *buf, size_t len, uint32_t now_ms)
+{
+	for (size_t i = 0; i < len; i++) {
+		uint16_t n = msg_kiss_rx_byte(&rx, buf[i]);
+		if (n > 0) {
+			on_frame(rx.buf, n, now_ms);
+		}
+	}
+}
+
+bool msg_bridge_in_frame(void)
+{
+	return rx.in_frame && rx.len > 0;
+}
+
+size_t msg_bridge_output(uint8_t *buf, size_t max)
+{
+	size_t n = 0;
+	lock();
+	while (frame_count > 0 && n + frame_len[frame_head] <= max) {
+		uint16_t fl = frame_len[frame_head];
+		for (uint16_t i = 0; i < fl; i++) {
+			buf[n++] = out_ring[out_head];
+			out_head = (uint16_t)((out_head + 1u) % MSG_BRIDGE_OUT_BYTES);
+		}
+		out_used = (uint16_t)(out_used - fl);
+		frame_head = (uint8_t)((frame_head + 1u) % OUT_FRAMES_MAX);
+		frame_count--;
+	}
+	unlock();
+	return n;
+}
+
+void msg_bridge_tick(uint32_t now_ms)
+{
+	if (attached && (uint32_t)(now_ms - last_host_ms) > MSG_LINK_TIMEOUT_MS) {
+		attached = false;		// the host went away: the radio is a standalone messenger again
+		mode = MSG_LINK_MODE_DEFAULT;
+		lock();
+		out_head = out_tail = out_used = 0;
+		frame_head = frame_count = 0;
+		unlock();
+	}
+}
+
+bool msg_bridge_attached(void)
+{
+	return attached;
+}
+
+bool msg_bridge_suppress_auto_ack(void)
+{
+	return attached && (mode & MSG_LINK_MODE_BRIDGE) != 0;
+}
+
+bool msg_bridge_local_store(void)
+{
+	return !attached || (mode & MSG_LINK_MODE_STORE) != 0;
+}
+
+void msg_bridge_on_rx(const uint8_t packet[MSG_PKT_WIRE_LEN], int8_t rssi)
+{
+	if (!attached) {
+		return;
+	}
+	uint8_t head[2] = { MSG_LINK_EV_RX, (uint8_t)rssi };
+	uint8_t enc[MSG_LINK_FRAME_MAX];
+	size_t n = msg_kiss_encode(enc, sizeof enc, MSG_LINK_CMD_CTRL, head, sizeof head, packet, MSG_PKT_WIRE_LEN);
+	lock();
+	(void)out_push(enc, n);
+	unlock();
+}
+
+void msg_bridge_on_tx_done(const uint8_t packet[MSG_PKT_WIRE_LEN], uint8_t result)
+{
+	if (!attached) {
+		return;
+	}
+	uint8_t r[4] = { packet[5], packet[7], packet[8], result };	// type, id LE (wire offsets, msg_packet.h)
+	send_ctrl(MSG_LINK_EV_TX_RESULT, r, sizeof r);
+}
+
+uint16_t msg_bridge_dropped(void)
+{
+	return dropped;
+}
diff --git a/core/messenger/msg_bridge.h b/core/messenger/msg_bridge.h
new file mode 100644
index 0000000..7b6a9dd
--- /dev/null
+++ b/core/messenger/msg_bridge.h
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 The RadioFoundry Authors
+// The radio's side of the messenger link (msg_link.h, docs/bridge-protocol.md): it parses the host's KISS frames,
+// hands packets to transmit to the board, and queues received frames and transmit results for the host.
+//
+// No board or RTOS header: the board passes its hooks in msg_bridge_ops_t. The byte side (feed/output/in_frame) has
+// the shape of the host link's TNC slot (core/hostlink: claims/feed/in_frame/output), so a board with a host link
+// registers it there; a board without one polls its UART and calls feed/output itself.
+//
+// Tasks: feed/output/tick run on the link side (one task); on_rx/on_tx_done may run on the radio task. The output
+// queue is the only shared state; it is guarded by ops.lock/unlock when the two sides are different tasks.
+#ifndef MSG_BRIDGE_H
+#define MSG_BRIDGE_H
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include "messenger/msg_packet.h"
+
+#define MSG_BRIDGE_OUT_BYTES	640u	// output queue: about three RX events plus replies
+
+typedef struct {
+	// Queue one validated GGM2 packet for transmit on the radio's current channel. Called from feed(). Return false
+	// when a transmit is already pending (the host gets QUEUE_FULL). The board reports the outcome later through
+	// msg_bridge_on_tx_done().
+	bool (*tx_packet)(void *ctx, const uint8_t packet[MSG_PKT_WIRE_LEN]);
+	// The host set the radio's callsign (NUL-terminated, 1..8 chars). May be NULL.
+	void (*set_call)(void *ctx, const char *call);
+	// Capability bits for the HELLO reply (MSG_LINK_CAP_*). May be NULL (then TX only).
+	uint8_t (*caps)(void *ctx);
+	// Guard the output queue (NULL when feed/output and on_rx share one task).
+	void (*lock)(void *ctx);
+	void (*unlock)(void *ctx);
+	void *ctx;
+} msg_bridge_ops_t;
+
+// Start (or restart) with the board's hooks and its current callsign. The bridge starts detached.
+void msg_bridge_init(const msg_bridge_ops_t *ops, const char *call);
+
+// Byte side (link task)
+bool msg_bridge_claims(uint8_t b);				// true for FEND: a link frame starts
+void msg_bridge_feed(const uint8_t *buf, size_t len, uint32_t now_ms);
+bool msg_bridge_in_frame(void);
+size_t msg_bridge_output(uint8_t *buf, size_t max);	// whole frames only; 0 when there is nothing to send
+void msg_bridge_tick(uint32_t now_ms);			// leaves bridge mode after MSG_LINK_TIMEOUT_MS of silence
+
+// State, for the board's messenger code (radio task)
+bool msg_bridge_attached(void);		// a host said HELLO and is still talking
+bool msg_bridge_suppress_auto_ack(void);	// attached and in BRIDGE mode: don't send the radio's own ACKs
+bool msg_bridge_local_store(void);	// detached, or STORE mode: file received TEXT in the radio's inbox
+
+// Events from the radio (radio task). Dropped while detached, or when the output queue is full (counted).
+void msg_bridge_on_rx(const uint8_t packet[MSG_PKT_WIRE_LEN], int8_t rssi);
+void msg_bridge_on_tx_done(const uint8_t packet[MSG_PKT_WIRE_LEN], uint8_t result);
+uint16_t msg_bridge_dropped(void);
+
+#endif
diff --git a/core/messenger/msg_kiss.c b/core/messenger/msg_kiss.c
new file mode 100644
index 0000000..20b63ba
--- /dev/null
+++ b/core/messenger/msg_kiss.c
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 The RadioFoundry Authors
+// KISS framing (msg_kiss.h).
+#include "messenger/msg_kiss.h"
+
+void msg_kiss_rx_init(msg_kiss_rx_t *rx)
+{
+	rx->len = 0;
+	rx->in_frame = false;
+	rx->esc = false;
+	rx->overflow = false;
+}
+
+static void put(msg_kiss_rx_t *rx, uint8_t b)
+{
+	if (rx->len < MSG_KISS_MAX_FRAME) {
+		rx->buf[rx->len++] = b;
+	} else {
+		rx->overflow = true;
+	}
+}
+
+uint16_t msg_kiss_rx_byte(msg_kiss_rx_t *rx, uint8_t b)
+{
+	if (b == MSG_KISS_FEND) {
+		uint16_t done = (rx->in_frame && !rx->overflow) ? rx->len : 0;
+		// A FEND both closes the frame in progress and opens the next one (back-to-back frames share it).
+		rx->in_frame = true;
+		rx->esc = false;
+		rx->overflow = false;
+		rx->len = 0;
+		return done;
+	}
+	if (!rx->in_frame) {
+		return 0;			// noise before the first FEND
+	}
+	if (rx->esc) {
+		rx->esc = false;
+		if (b == MSG_KISS_TFEND) {
+			put(rx, MSG_KISS_FEND);
+		} else if (b == MSG_KISS_TFESC) {
+			put(rx, MSG_KISS_FESC);
+		} else {
+			rx->overflow = true;	// a protocol error: drop the frame at its closing FEND
+		}
+		return 0;
+	}
+	if (b == MSG_KISS_FESC) {
+		rx->esc = true;
+		return 0;
+	}
+	put(rx, b);
+	return 0;
+}
+
+static bool emit(uint8_t *out, size_t out_max, size_t *n, uint8_t b)
+{
+	if (b == MSG_KISS_FEND || b == MSG_KISS_FESC) {
+		if (*n + 2u > out_max) {
+			return false;
+		}
+		out[(*n)++] = MSG_KISS_FESC;
+		out[(*n)++] = (b == MSG_KISS_FEND) ? MSG_KISS_TFEND : MSG_KISS_TFESC;
+		return true;
+	}
+	if (*n + 1u > out_max) {
+		return false;
+	}
+	out[(*n)++] = b;
+	return true;
+}
+
+size_t msg_kiss_encode(uint8_t *out, size_t out_max, uint8_t cmd, const uint8_t *head, size_t hlen,
+	const uint8_t *data, size_t dlen)
+{
+	size_t n = 0;
+	if (out == NULL || out_max < 3u) {
+		return 0;
+	}
+	out[n++] = MSG_KISS_FEND;
+	if (!emit(out, out_max, &n, cmd)) {
+		return 0;
+	}
+	for (size_t i = 0; i < hlen; i++) {
+		if (!emit(out, out_max, &n, head[i])) {
+			return 0;
+		}
+	}
+	for (size_t i = 0; i < dlen; i++) {
+		if (!emit(out, out_max, &n, data[i])) {
+			return 0;
+		}
+	}
+	if (n + 1u > out_max) {
+		return 0;
+	}
+	out[n++] = MSG_KISS_FEND;
+	return n;
+}
diff --git a/core/messenger/msg_kiss.h b/core/messenger/msg_kiss.h
new file mode 100644
index 0000000..72af702
--- /dev/null
+++ b/core/messenger/msg_kiss.h
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 The RadioFoundry Authors
+// KISS framing (the public TNC host protocol): FEND 0xC0 delimits frames, FESC 0xDB escapes FEND/FESC inside them.
+// The first byte of a frame is the command: high nibble = port, low nibble = command (0 = data, 6 = SetHardware).
+// Used as the byte framing of the messenger link (msg_link.h) between a radio and its host (an ESP32, a PC).
+#ifndef MSG_KISS_H
+#define MSG_KISS_H
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+
+#define MSG_KISS_FEND		0xC0u
+#define MSG_KISS_FESC		0xDBu
+#define MSG_KISS_TFEND		0xDCu
+#define MSG_KISS_TFESC		0xDDu
+#define MSG_KISS_MAX_FRAME	128u	// command byte + data, unescaped; the link's largest frame is 98 bytes
+
+typedef struct {
+	uint8_t  buf[MSG_KISS_MAX_FRAME];	// command byte + data of the frame in progress / just completed
+	uint16_t len;
+	bool     in_frame;			// a FEND opened a frame and bytes are being collected
+	bool     esc;			// the previous byte was FESC
+	bool     overflow;			// the frame outgrew buf: it is dropped at its closing FEND
+} msg_kiss_rx_t;
+
+void msg_kiss_rx_init(msg_kiss_rx_t *rx);
+
+// Feed one received byte. Returns the length of a frame that just completed (buf[0] = command, then the data), or 0.
+// Empty frames (FEND FEND) and overflowed frames are dropped. The returned frame stays valid until the next byte.
+uint16_t msg_kiss_rx_byte(msg_kiss_rx_t *rx, uint8_t b);
+
+// Encode one frame: FEND, cmd, head[0..hlen), data[0..dlen) (both escaped), FEND. head or data may be NULL with length
+// 0. Returns the bytes written, or 0 when out_max is too small (nothing useful is written then).
+size_t msg_kiss_encode(uint8_t *out, size_t out_max, uint8_t cmd, const uint8_t *head, size_t hlen,
+	const uint8_t *data, size_t dlen);
+
+// Worst-case encoded size for a frame of n unescaped bytes after the command byte.
+#define MSG_KISS_ENCODED_MAX(n)	(2u * ((n) + 1u) + 2u)
+
+#endif
diff --git a/core/messenger/msg_link.c b/core/messenger/msg_link.c
new file mode 100644
index 0000000..23f9b78
--- /dev/null
+++ b/core/messenger/msg_link.c
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 The RadioFoundry Authors
+// The messenger link, host side (msg_link.h).
+#include <string.h>
+#include "messenger/msg_link.h"
+#include "messenger/msg_kiss.h"
+
+size_t msg_link_encode_tx(uint8_t *out, size_t out_max, const uint8_t packet[MSG_PKT_WIRE_LEN])
+{
+	return msg_kiss_encode(out, out_max, MSG_LINK_CMD_DATA, NULL, 0, packet, MSG_PKT_WIRE_LEN);
+}
+
+static size_t ctrl(uint8_t *out, size_t out_max, uint8_t op, const uint8_t *data, size_t len)
+{
+	return msg_kiss_encode(out, out_max, MSG_LINK_CMD_CTRL, &op, 1, data, len);
+}
+
+size_t msg_link_encode_hello(uint8_t *out, size_t out_max)
+{
+	uint8_t v = MSG_LINK_VERSION;
+	return ctrl(out, out_max, MSG_LINK_OP_HELLO, &v, 1);
+}
+
+size_t msg_link_encode_set_call(uint8_t *out, size_t out_max, const char *call)
+{
+	size_t n = 0;
+	while (call != NULL && call[n] != '\0' && n < MSG_CALLSIGN_LEN) {
+		n++;
+	}
+	if (n == 0) {
+		return 0;
+	}
+	return ctrl(out, out_max, MSG_LINK_OP_SET_CALL, (const uint8_t *)call, n);
+}
+
+size_t msg_link_encode_keepalive(uint8_t *out, size_t out_max)
+{
+	return ctrl(out, out_max, MSG_LINK_OP_KEEPALIVE, NULL, 0);
+}
+
+size_t msg_link_encode_set_mode(uint8_t *out, size_t out_max, uint8_t mode)
+{
+	return ctrl(out, out_max, MSG_LINK_OP_SET_MODE, &mode, 1);
+}
+
+bool msg_link_decode_event(const uint8_t *frame, uint16_t len, msg_link_event_t *ev)
+{
+	memset(ev, 0, sizeof *ev);
+	if (frame == NULL || len < 2u || frame[0] != MSG_LINK_CMD_CTRL) {
+		return false;
+	}
+	const uint8_t *d = &frame[2];
+	uint16_t n = (uint16_t)(len - 2u);
+	switch (frame[1]) {
+	case MSG_LINK_EV_RX:
+		if (n != 1u + MSG_PKT_WIRE_LEN) {
+			return false;
+		}
+		ev->kind = MSG_LINK_EVENT_RX;
+		ev->rssi = (int8_t)d[0];
+		memcpy(ev->packet, &d[1], MSG_PKT_WIRE_LEN);
+		return true;
+	case MSG_LINK_EV_HELLO:
+		if (n < 3u || n > 3u + MSG_CALLSIGN_LEN) {
+			return false;
+		}
+		ev->kind = MSG_LINK_EVENT_HELLO;
+		ev->version = d[0];
+		ev->mode = d[1];
+		ev->caps = d[2];
+		for (uint16_t i = 3; i < n && d[i] != 0; i++) {
+			ev->call[i - 3u] = (char)d[i];
+		}
+		return true;
+	case MSG_LINK_EV_TX_RESULT:
+		if (n != 4u) {
+			return false;
+		}
+		ev->kind = MSG_LINK_EVENT_TX_RESULT;
+		ev->tx_type = d[0];
+		ev->tx_id = (uint16_t)(d[1] | ((uint16_t)d[2] << 8));
+		ev->result = d[3];
+		return true;
+	case MSG_LINK_EV_ERROR:
+		if (n != 2u) {
+			return false;
+		}
+		ev->kind = MSG_LINK_EVENT_ERROR;
+		ev->op = d[0];
+		ev->error = d[1];
+		return true;
+	default:
+		return false;
+	}
+}
diff --git a/core/messenger/msg_link.h b/core/messenger/msg_link.h
new file mode 100644
index 0000000..bca7de5
--- /dev/null
+++ b/core/messenger/msg_link.h
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 The RadioFoundry Authors
+// The messenger link: a radio's GGM2 modem offered to a host (an ESP32 inside the radio or on the programming cable,
+// or a PC) over a UART, in KISS frames on KISS port 1. The radio only moves GGM2 packets on and off the air; the host
+// owns the messaging protocol (relay, dedup, ACKs, retries, storage). Spec: docs/bridge-protocol.md.
+//
+//   host -> radio                                   radio -> host
+//   0x10 <94-byte GGM2 packet>      transmit it     0x16 0x80 <rssi i8> <94-byte packet>   a frame was received
+//   0x16 0x01 <version>             HELLO           0x16 0x81 <version> <mode> <caps> <call 8>   HELLO reply
+//   0x16 0x02 <call, 1..8 bytes>    set callsign    0x16 0x82 <type> <id LE16> <result>   transmit result
+//   0x16 0x03                       keepalive       0x16 0x8F <op> <error>                 request refused
+//   0x16 0x04 <mode>                set mode
+//
+// This file holds the constants both ends share and the host's side (encode requests, decode the radio's events).
+// The radio's side is msg_bridge.h.
+#ifndef MSG_LINK_H
+#define MSG_LINK_H
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include "messenger/msg_packet.h"
+
+#define MSG_LINK_VERSION	1u
+#define MSG_LINK_PORT		1u			// KISS port; port 0 stays free for an APRS TNC
+#define MSG_LINK_CMD_DATA	((MSG_LINK_PORT << 4) | 0x0u)	// 0x10
+#define MSG_LINK_CMD_CTRL	((MSG_LINK_PORT << 4) | 0x6u)	// 0x16 (KISS SetHardware)
+
+// host -> radio control ops
+#define MSG_LINK_OP_HELLO	0x01u	// [version]: attach; the radio answers with HELLO_REPLY and enters bridge mode
+#define MSG_LINK_OP_SET_CALL	0x02u	// [call 1..8]: the radio's own callsign (its UI and any frame it builds itself)
+#define MSG_LINK_OP_KEEPALIVE	0x03u	// []: no reply; any frame from the host counts as a keepalive
+#define MSG_LINK_OP_SET_MODE	0x04u	// [mode]: MSG_LINK_MODE_* bits; answered with HELLO_REPLY
+
+// radio -> host events
+#define MSG_LINK_EV_RX		0x80u
+#define MSG_LINK_EV_HELLO	0x81u
+#define MSG_LINK_EV_TX_RESULT	0x82u
+#define MSG_LINK_EV_ERROR	0x8Fu
+
+// Mode bits (HELLO sets MSG_LINK_MODE_DEFAULT)
+#define MSG_LINK_MODE_BRIDGE	0x01u	// the radio does not answer TEXT with its own ACK: the host does
+#define MSG_LINK_MODE_STORE	0x02u	// the radio still files received TEXT in its own inbox (its screen shows them)
+#define MSG_LINK_MODE_DEFAULT	(MSG_LINK_MODE_BRIDGE | MSG_LINK_MODE_STORE)
+
+// Capability bits in the HELLO reply
+#define MSG_LINK_CAP_TX		0x01u	// the radio can transmit here (false on a receive-only build)
+#define MSG_LINK_CAP_LBT	0x02u	// the radio waits for a clear channel before it keys up
+
+// Transmit results
+#define MSG_LINK_TX_OK		0u
+#define MSG_LINK_TX_BUSY	1u	// the channel stayed busy (listen-before-talk gave up)
+#define MSG_LINK_TX_REFUSED	2u	// no TX here (out of a TX band, receive-only, TX inhibited)
+#define MSG_LINK_TX_QUEUE_FULL	3u	// a transmit is already pending: send again after its result
+#define MSG_LINK_TX_TIMEOUT	4u	// the burst never finished
+
+// Errors
+#define MSG_LINK_ERR_BAD_PACKET	1u	// the data frame is not a valid GGM2 packet (length, magic, version, CRC)
+#define MSG_LINK_ERR_BAD_OP	2u
+#define MSG_LINK_ERR_BAD_LEN	3u
+
+#define MSG_LINK_TIMEOUT_MS	15000u	// the radio leaves bridge mode after this long without a frame from the host
+#define MSG_LINK_KEEPALIVE_MS	5000u	// how often the host should send something
+
+// Largest encoded link frame (RX event: cmd, op, rssi, 94 bytes, all escaped, plus two FENDs)
+#define MSG_LINK_FRAME_MAX	(2u * (3u + MSG_PKT_WIRE_LEN) + 2u)
+
+// ---- host side ----------------------------------------------------------------------------------------------------
+// Each returns the encoded byte count written to out (out_max >= MSG_LINK_FRAME_MAX is always enough), 0 on error.
+size_t msg_link_encode_tx(uint8_t *out, size_t out_max, const uint8_t packet[MSG_PKT_WIRE_LEN]);
+size_t msg_link_encode_hello(uint8_t *out, size_t out_max);
+size_t msg_link_encode_set_call(uint8_t *out, size_t out_max, const char *call);
+size_t msg_link_encode_keepalive(uint8_t *out, size_t out_max);
+size_t msg_link_encode_set_mode(uint8_t *out, size_t out_max, uint8_t mode);
+
+typedef enum {
+	MSG_LINK_EVENT_NONE = 0,
+	MSG_LINK_EVENT_RX,		// rssi, packet
+	MSG_LINK_EVENT_HELLO,		// version, mode, caps, call
+	MSG_LINK_EVENT_TX_RESULT,	// tx_type, tx_id, result
+	MSG_LINK_EVENT_ERROR,		// op, error
+} msg_link_event_kind_t;
+
+typedef struct {
+	msg_link_event_kind_t kind;
+	int8_t   rssi;
+	uint8_t  packet[MSG_PKT_WIRE_LEN];
+	uint8_t  version, mode, caps;
+	char     call[MSG_CALLSIGN_LEN + 1];
+	uint8_t  tx_type;
+	uint16_t tx_id;
+	uint8_t  result;
+	uint8_t  op, error;
+} msg_link_event_t;
+
+// Decode one completed KISS frame (msg_kiss_rx_byte's buf/len) from the radio. Returns false (kind NONE) for frames
+// that are not the link's (another port, unknown op, wrong length).
+bool msg_link_decode_event(const uint8_t *frame, uint16_t len, msg_link_event_t *ev);
+
+#endif
diff --git a/core/messenger/msg_mesh.c b/core/messenger/msg_mesh.c
new file mode 100644
index 0000000..0396a4c
--- /dev/null
+++ b/core/messenger/msg_mesh.c
@@ -0,0 +1,288 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 The RadioFoundry Authors
+// Store-and-forward mesh over GGM2 (msg_mesh.h).
+#include <string.h>
+#include "messenger/msg_mesh.h"
+
+void msg_mesh_default_cfg(msg_mesh_cfg_t *cfg, const char *call)
+{
+	memset(cfg, 0, sizeof *cfg);
+	for (unsigned i = 0; call != NULL && call[i] != '\0' && i < MSG_CALLSIGN_LEN; i++) {
+		cfg->call[i] = call[i];
+	}
+	cfg->ttl = 3;
+	cfg->relay = true;
+	cfg->ack_broadcast = true;
+	cfg->retries = 2;
+	cfg->relay_min_ms = 200;
+	cfg->relay_slot_ms = 1200;	// one GGM2 burst on air is ~0.9 s
+	cfg->relay_slots = 4;
+	// One GGM2 burst is about 0.9 s on air (16-byte preamble + 100 bytes at 1200 baud) plus keying; a hop costs a
+	// relay delay and a burst each way.
+	cfg->ack_base_ms = 3000;
+	cfg->ack_hop_ms = 4500;
+}
+
+void msg_mesh_init(msg_mesh_t *m, const msg_mesh_cfg_t *cfg, const msg_mesh_ops_t *ops)
+{
+	memset(m, 0, sizeof *m);
+	m->cfg = *cfg;
+	m->ops = *ops;
+	m->next_id = (uint16_t)(ops->rand(ops->ctx) | 1u);
+}
+
+void msg_mesh_set_call(msg_mesh_t *m, const char *call)
+{
+	memset(m->cfg.call, 0, sizeof m->cfg.call);
+	for (unsigned i = 0; call != NULL && call[i] != '\0' && i < MSG_CALLSIGN_LEN; i++) {
+		m->cfg.call[i] = call[i];
+	}
+}
+
+static bool same_call(const char *a, const char *b)
+{
+	return strncmp(a, b, MSG_CALLSIGN_LEN) == 0;
+}
+
+static bool is_all(const char *to)
+{
+	return to == NULL || to[0] == '\0' || same_call(to, MSG_PKT_TO_ALL);
+}
+
+static uint32_t rand_between(msg_mesh_t *m, uint32_t lo, uint32_t hi)
+{
+	if (hi <= lo) {
+		return lo;
+	}
+	return lo + m->ops.rand(m->ops.ctx) % (hi - lo + 1u);
+}
+
+static bool due(uint32_t now, uint32_t at)
+{
+	return (int32_t)(now - at) >= 0;
+}
+
+// ---- seen table ---------------------------------------------------------------------------------------------------
+static msg_mesh_seen_t *seen_find(msg_mesh_t *m, const char *from, uint16_t id, uint8_t type, uint32_t now)
+{
+	for (unsigned i = 0; i < MSG_MESH_SEEN_MAX; i++) {
+		msg_mesh_seen_t *s = &m->seen[i];
+		if (s->used && s->id == id && s->type == type &&
+		    memcmp(s->key_from, from, MSG_CALLSIGN_LEN) == 0) {
+			if ((uint32_t)(now - s->at) > MSG_MESH_SEEN_MS) {
+				s->used = false;	// expired: treat as new
+				return NULL;
+			}
+			return s;
+		}
+	}
+	return NULL;
+}
+
+static void seen_add(msg_mesh_t *m, const char *from, uint16_t id, uint8_t type, uint32_t now)
+{
+	msg_mesh_seen_t *s = &m->seen[m->seen_next];
+	m->seen_next = (uint8_t)((m->seen_next + 1u) % MSG_MESH_SEEN_MAX);
+	memset(s, 0, sizeof *s);
+	for (unsigned i = 0; i < MSG_CALLSIGN_LEN && from[i] != '\0'; i++) {
+		s->key_from[i] = (uint8_t)from[i];
+	}
+	s->id = id;
+	s->type = type;
+	s->at = now;
+	s->used = true;
+}
+
+// ---- relays -------------------------------------------------------------------------------------------------------
+static void relay_schedule(msg_mesh_t *m, const uint8_t packet[MSG_PKT_WIRE_LEN], uint8_t ttl_remain, uint32_t now)
+{
+	for (unsigned i = 0; i < MSG_MESH_RELAY_MAX; i++) {
+		msg_mesh_relay_t *r = &m->relay[i];
+		if (!r->used) {
+			r->used = true;
+			memcpy(r->packet, packet, MSG_PKT_WIRE_LEN);
+			msg_packet_set_ttl_remain(r->packet, (uint8_t)(ttl_remain - 1u));
+			uint32_t slots = m->cfg.relay_slots ? m->cfg.relay_slots : 1u;
+			uint32_t slot = m->ops.rand(m->ops.ctx) % slots;
+			r->due = now + m->cfg.relay_min_ms + slot * m->cfg.relay_slot_ms + rand_between(m, 0, 99);
+			return;
+		}
+	}
+	// Relay table full: this copy is dropped; a neighbor will usually carry it.
+}
+
+// Another node relayed the frame we were about to relay: ours adds nothing for the shared neighborhood.
+static void relay_cancel(msg_mesh_t *m, const msg_packet_t *p)
+{
+	for (unsigned i = 0; i < MSG_MESH_RELAY_MAX; i++) {
+		msg_mesh_relay_t *r = &m->relay[i];
+		if (!r->used) {
+			continue;
+		}
+		msg_packet_t q;
+		if (msg_packet_parse(r->packet, MSG_PKT_WIRE_LEN, &q) && q.id == p->id && q.type == p->type &&
+		    same_call(q.from, p->from)) {
+			r->used = false;
+			m->suppressed++;
+		}
+	}
+}
+
+// ---- own messages -------------------------------------------------------------------------------------------------
+static uint32_t ack_window(const msg_mesh_t *m, uint8_t ttl)
+{
+	return (uint32_t)m->cfg.ack_base_ms + (uint32_t)m->cfg.ack_hop_ms * ttl;
+}
+
+static void send_ack(msg_mesh_t *m, const msg_packet_t *p, uint8_t ttl)
+{
+	uint8_t pkt[MSG_PKT_WIRE_LEN];
+	if (msg_packet_build_ack_ttl(pkt, sizeof pkt, p->id, m->cfg.call, p->from, ttl) == MSG_PKT_WIRE_LEN) {
+		m->ops.send(m->ops.ctx, pkt);
+	}
+}
+
+bool msg_mesh_send_text(msg_mesh_t *m, const char *to, const char *text, uint32_t now_ms, uint16_t *id_out)
+{
+	if (text == NULL || text[0] == '\0') {
+		return false;
+	}
+	msg_mesh_pending_t *slot = NULL;
+	for (unsigned i = 0; i < MSG_MESH_PENDING_MAX; i++) {
+		if (!m->pending[i].used) {
+			slot = &m->pending[i];
+			break;
+		}
+	}
+	if (slot == NULL) {
+		return false;
+	}
+	uint16_t id = m->next_id++;
+	if (m->next_id == 0) {
+		m->next_id = 1;
+	}
+	uint8_t ttl = m->cfg.ttl ? m->cfg.ttl : 1u;
+	if (msg_packet_build_text_to(slot->packet, sizeof slot->packet, id, m->cfg.call, is_all(to) ? MSG_PKT_TO_ALL : to,
+		text, ttl) != MSG_PKT_WIRE_LEN) {
+		return false;
+	}
+	slot->used = true;
+	slot->to_all = is_all(to);
+	slot->id = id;
+	slot->tries = 1;
+	slot->deadline = now_ms + ack_window(m, ttl);
+	seen_add(m, m->cfg.call, id, MSG_PKT_TYPE_TEXT, now_ms);
+	m->ops.send(m->ops.ctx, slot->packet);
+	if (m->ops.status != NULL) {
+		m->ops.status(m->ops.ctx, id, MSG_MESH_ST_SENT);
+	}
+	if (id_out != NULL) {
+		*id_out = id;
+	}
+	return true;
+}
+
+static void pending_acked(msg_mesh_t *m, uint16_t id)
+{
+	for (unsigned i = 0; i < MSG_MESH_PENDING_MAX; i++) {
+		msg_mesh_pending_t *pd = &m->pending[i];
+		if (pd->used && pd->id == id) {
+			pd->used = false;
+			if (m->ops.status != NULL) {
+				m->ops.status(m->ops.ctx, id, MSG_MESH_ST_ACKED);
+			}
+			return;
+		}
+	}
+}
+
+// ---- receive ------------------------------------------------------------------------------------------------------
+void msg_mesh_on_rx(msg_mesh_t *m, const uint8_t packet[MSG_PKT_WIRE_LEN], int8_t rssi, uint32_t now_ms)
+{
+	msg_packet_t p;
+	if (!msg_packet_parse(packet, MSG_PKT_WIRE_LEN, &p)) {
+		return;
+	}
+	if (same_call(p.from, m->cfg.call)) {
+		relay_cancel(m, &p);		// our own frame echoed by a relay: nothing to do
+		return;
+	}
+	if (m->ops.heard != NULL) {
+		m->ops.heard(m->ops.ctx, &p, rssi);
+	}
+	uint8_t hops = (p.ttl_init >= p.ttl_remain) ? (uint8_t)(p.ttl_init - p.ttl_remain) : 0u;
+	bool to_me = same_call(p.to, m->cfg.call);
+	bool to_all = same_call(p.to, MSG_PKT_TO_ALL);
+
+	if (seen_find(m, p.from, p.id, p.type, now_ms) != NULL) {
+		m->duplicates++;
+		relay_cancel(m, &p);
+		if (p.type == MSG_PKT_TYPE_TEXT && to_me) {
+			send_ack(m, &p, (uint8_t)(hops + 1u));	// the sender is retrying: our ACK may have been lost
+		}
+		return;
+	}
+	seen_add(m, p.from, p.id, p.type, now_ms);
+
+	switch (p.type) {
+	case MSG_PKT_TYPE_TEXT:
+		if (to_me || to_all) {
+			m->ops.deliver(m->ops.ctx, &p, rssi, hops);
+		}
+		if (to_me) {
+			send_ack(m, &p, (uint8_t)(hops + 1u));
+		} else if (to_all && hops == 0 && m->cfg.ack_broadcast) {
+			send_ack(m, &p, 1);
+		}
+		if (!to_me && m->cfg.relay && p.ttl_remain > 1u) {
+			relay_schedule(m, packet, p.ttl_remain, now_ms);
+			m->relayed++;
+		}
+		break;
+	case MSG_PKT_TYPE_ACK:
+		if (to_me) {
+			pending_acked(m, p.id);
+		} else if (m->cfg.relay && p.ttl_remain > 1u) {
+			relay_schedule(m, packet, p.ttl_remain, now_ms);
+			m->relayed++;
+		}
+		break;
+	default:
+		break;				// PING/PONG/WAKE: neighbor-only
+	}
+}
+
+void msg_mesh_tick(msg_mesh_t *m, uint32_t now_ms)
+{
+	for (unsigned i = 0; i < MSG_MESH_RELAY_MAX; i++) {
+		msg_mesh_relay_t *r = &m->relay[i];
+		if (r->used && due(now_ms, r->due)) {
+			r->used = false;
+			m->ops.send(m->ops.ctx, r->packet);
+		}
+	}
+	for (unsigned i = 0; i < MSG_MESH_PENDING_MAX; i++) {
+		msg_mesh_pending_t *pd = &m->pending[i];
+		if (!pd->used || !due(now_ms, pd->deadline)) {
+			continue;
+		}
+		if (pd->to_all) {
+			pd->used = false;
+			if (m->ops.status != NULL) {
+				m->ops.status(m->ops.ctx, pd->id, MSG_MESH_ST_NO_ACK);
+			}
+		} else if (pd->tries <= m->cfg.retries) {
+			pd->tries++;
+			pd->deadline = now_ms + ack_window(m, pd->packet[9]) + rand_between(m, 200, 800);
+			m->ops.send(m->ops.ctx, pd->packet);	// same id: receivers dedup it and ACK again
+			if (m->ops.status != NULL) {
+				m->ops.status(m->ops.ctx, pd->id, MSG_MESH_ST_SENT);
+			}
+		} else {
+			pd->used = false;
+			if (m->ops.status != NULL) {
+				m->ops.status(m->ops.ctx, pd->id, MSG_MESH_ST_FAILED);
+			}
+		}
+	}
+}
diff --git a/core/messenger/msg_mesh.h b/core/messenger/msg_mesh.h
new file mode 100644
index 0000000..9696222
--- /dev/null
+++ b/core/messenger/msg_mesh.h
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 The RadioFoundry Authors
+// A small store-and-forward mesh on top of GGM2, run by the link host (the ESP32): the radio is only its modem.
+// Rules (docs/bridge-protocol.md, section "Mesh"):
+//   - Dedup on (from, id, type), remembered MSG_MESH_SEEN_MS.
+//   - TEXT and ACK are relayed while ttl_remain > 1, with ttl_remain - 1 and a random delay; a relay is cancelled if
+//     another node's copy of the same frame is heard first (one copy per neighborhood is enough). The delay is a
+//     random slot longer than a burst, so the earliest relay is heard before the others fire.
+//   - TEXT to us: delivered and ACKed with a hop budget of the hops it took + 1, so the ACK comes back over relays.
+//     A duplicate TEXT to us is ACKed again (our first ACK may have been lost) but not delivered again.
+//   - TEXT to ALL: delivered; ACKed (budget 1) only when heard first-hand, as a plain GOGUFW radio does.
+//   - Our own TEXT: retried until ACKed (direct) or one ACK window passes (to ALL).
+//   - PING/PONG/WAKE are neighbor-only: never relayed.
+// No globals: one msg_mesh_t per node, so host tests can run a whole network in one process.
+#ifndef MSG_MESH_H
+#define MSG_MESH_H
+
+#include <stdint.h>
+#include <stdbool.h>
+#include "messenger/msg_packet.h"
+
+#define MSG_MESH_SEEN_MAX	48u
+#define MSG_MESH_SEEN_MS	120000u	// how long a frame key is remembered (a 16-bit id wraps much later)
+#define MSG_MESH_RELAY_MAX	6u
+#define MSG_MESH_PENDING_MAX	4u	// own messages waiting for an ACK
+
+typedef enum {
+	MSG_MESH_ST_SENT = 0,	// on the air (each try)
+	MSG_MESH_ST_ACKED,	// delivered: an ACK came back
+	MSG_MESH_ST_NO_ACK,	// to ALL: the window passed with no ACK (it may still have been heard)
+	MSG_MESH_ST_FAILED,	// direct: every try went unanswered
+} msg_mesh_status_t;
+
+typedef struct {
+	// Put one packet on the air (through the link). The mesh never sends two at once on its own; the host's link
+	// queue serializes them.
+	void (*send)(void *ctx, const uint8_t packet[MSG_PKT_WIRE_LEN]);
+	// A TEXT for us or for ALL, first copy only.
+	void (*deliver)(void *ctx, const msg_packet_t *p, int8_t rssi, uint8_t hops);
+	// Progress of one of our own messages. May be NULL.
+	void (*status)(void *ctx, uint16_t id, msg_mesh_status_t st);
+	// Any valid frame heard first-hand or relayed (HEARD list, logging). May be NULL.
+	void (*heard)(void *ctx, const msg_packet_t *p, int8_t rssi);
+	uint32_t (*rand)(void *ctx);
+	void *ctx;
+} msg_mesh_ops_t;
+
+typedef struct {
+	char     call[MSG_CALLSIGN_LEN + 1];
+	uint8_t  ttl;			// hop budget of our own TEXT (1 = neighbors only); GOGUFW uses 3
+	bool     relay;			// forward other stations' TEXT/ACK
+	bool     ack_broadcast;		// ACK first-hand TEXT to ALL (GOGUFW behavior)
+	uint8_t  retries;		// extra tries for a direct TEXT
+	// Relay delay = relay_min_ms + a random slot of relay_slot_ms (0..relay_slots-1) + 0..99 ms jitter. A slot is
+	// longer than one burst, so a relay in an earlier slot is heard, and suppresses the others, before they fire.
+	uint16_t relay_min_ms, relay_slot_ms;
+	uint8_t  relay_slots;
+	uint16_t ack_base_ms;		// ACK window = ack_base_ms + ack_hop_ms * ttl
+	uint16_t ack_hop_ms;
+} msg_mesh_cfg_t;
+
+void msg_mesh_default_cfg(msg_mesh_cfg_t *cfg, const char *call);
+
+typedef struct {
+	uint8_t  key_from[MSG_CALLSIGN_LEN];
+	uint16_t id;
+	uint8_t  type;
+	uint32_t at;
+	bool     used;
+} msg_mesh_seen_t;
+
+typedef struct {
+	bool     used;
+	uint8_t  packet[MSG_PKT_WIRE_LEN];
+	uint32_t due;
+} msg_mesh_relay_t;
+
+typedef struct {
+	bool     used;
+	bool     to_all;
+	uint8_t  packet[MSG_PKT_WIRE_LEN];
+	uint16_t id;
+	uint8_t  tries;
+	uint32_t deadline;
+} msg_mesh_pending_t;
+
+typedef struct {
+	msg_mesh_cfg_t cfg;
+	msg_mesh_ops_t ops;
+	uint16_t next_id;
+	msg_mesh_seen_t seen[MSG_MESH_SEEN_MAX];
+	uint8_t  seen_next;
+	msg_mesh_relay_t relay[MSG_MESH_RELAY_MAX];
+	msg_mesh_pending_t pending[MSG_MESH_PENDING_MAX];
+	uint16_t relayed, suppressed, duplicates;	// counters for a status page
+} msg_mesh_t;
+
+void msg_mesh_init(msg_mesh_t *m, const msg_mesh_cfg_t *cfg, const msg_mesh_ops_t *ops);
+void msg_mesh_set_call(msg_mesh_t *m, const char *call);
+
+// Send a TEXT (to NULL/""/"ALL" = broadcast). Returns false when the pending table is full or text is empty.
+bool msg_mesh_send_text(msg_mesh_t *m, const char *to, const char *text, uint32_t now_ms, uint16_t *id_out);
+
+// A frame came in from the radio.
+void msg_mesh_on_rx(msg_mesh_t *m, const uint8_t packet[MSG_PKT_WIRE_LEN], int8_t rssi, uint32_t now_ms);
+
+// Run timers (relays due, ACK windows). Call every 10..100 ms.
+void msg_mesh_tick(msg_mesh_t *m, uint32_t now_ms);
+
+#endif
