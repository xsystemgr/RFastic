@@ -84,11 +90,23 @@ uint8_t msg_packet_build_text(uint8_t *out, uint8_t out_len, uint16_t id, const
 }
 
 uint8_t msg_packet_build_ack(uint8_t *out, uint8_t out_len, uint16_t id, const char *from, const char *to)
+{
+	return msg_packet_build_ack_ttl(out, out_len, id, from, to, 1);
+}
+
+void msg_packet_set_ttl_remain(uint8_t packet[MSG_PKT_WIRE_LEN], uint8_t ttl_remain)
+{
+	packet[10] = ttl_remain;
+	finalize(packet);
+}
+
+uint8_t msg_packet_build_ack_ttl(uint8_t *out, uint8_t out_len, uint16_t id, const char *from, const char *to,
+	uint8_t ttl)
 {
 	if (out == NULL || out_len < MSG_PKT_WIRE_LEN) {
 		return 0;
 	}
-	build_header(out, MSG_PKT_TYPE_ACK, id, from, to, 1, 1);
+	build_header(out, MSG_PKT_TYPE_ACK, id, from, to, ttl, ttl);
 	// Mirror the ACKed message id in the payload too, for a robust fallback match (GOGUFW RF21).
 	out[27] = 2;
 	out[28] = (uint8_t)(id & 0xFFu);
