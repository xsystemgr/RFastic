 static bk4819_t receiver, control;
 static uint16_t receiver_id, control_id;
@@ -361,6 +366,62 @@ static volatile bool msg_ack_pending;
 static char msg_ack_to[MSG_CALLSIGN_LEN + 1];
 static uint16_t msg_ack_id;
 
+#if CONFIG_MESSENGER_LINK
+// Messenger link (docs/bridge-protocol.md): a host on the UART (an ESP32 inside the radio) drives the GGM2 modem. Its
+// transmit requests wait here for the radio task, like the UI's. The link runs on the radio task too (from
+// rt880_msg_service), so the bridge needs no lock.
+static volatile bool br_tx_pending;
+static uint8_t br_tx_pkt[MSG_PKT_WIRE_LEN];
+static bool br_started;
+
+static bool br_tx(void *ctx, const uint8_t packet[MSG_PKT_WIRE_LEN])
+{
+	(void)ctx;
+	if (!ready || br_tx_pending) {
+		return false;
+	}
+	for (unsigned i = 0; i < MSG_PKT_WIRE_LEN; i++) {
+		br_tx_pkt[i] = packet[i];
+	}
+	br_tx_pending = true;
+	return true;
+}
+
+static void br_set_call(void *ctx, const char *call)
+{
+	(void)ctx;
+	rt880_msg_set_call(call);
+}
+
+static uint8_t br_caps(void *ctx)
+{
+	(void)ctx;
+	return MSG_LINK_CAP_TX;		// no listen-before-talk yet
+}
+
+static void link_service(void)
+{
+	uint32_t now = hal_millis();
+	if (!br_started) {
+		static const msg_bridge_ops_t ops = { .tx_packet = br_tx, .set_call = br_set_call, .caps = br_caps };
+		rt880_link_uart_init();
+		msg_bridge_init(&ops, msg_call);
+		br_started = true;
+	}
+	uint8_t in[64];
+	size_t n;
+	while ((n = rt880_link_uart_read(in, sizeof in)) > 0) {
+		msg_bridge_feed(in, n, now);
+	}
+	msg_bridge_tick(now);
+	uint8_t out[2u * MSG_LINK_FRAME_MAX];
+	n = msg_bridge_output(out, sizeof out);
+	if (n > 0) {
+		rt880_link_uart_write(out, n);
+	}
+}
+#endif
+
 // Key one GGM2 frame already packed into w[], returning to RX afterwards. Returns whether the burst completed.
 static bool msg_tx_frame(const uint16_t *w)
 {
@@ -418,6 +479,17 @@ void rt880_msg_service(void)
 	if (!ready) {
 		return;
 	}
+#if CONFIG_MESSENGER_LINK
+	link_service();
+	if (br_tx_pending) {
+		uint16_t w[MSG_FSK_WORDS];
+		msg_fsk_pack(w, br_tx_pkt);
+		bool ok = msg_tx_frame(w);
+		br_tx_pending = false;
+		msg_bridge_on_tx_done(br_tx_pkt, ok ? MSG_LINK_TX_OK : MSG_LINK_TX_REFUSED);
+		return;
+	}
+#endif
 	if (msg_tx_pending) {
 		msg_tx_run();
 		return;
@@ -435,18 +507,29 @@ void rt880_msg_service(void)
 	uint8_t pkt[MSG_PKT_WIRE_LEN];
 	if (msg_fsk_unpack(pkt, msg_rx_words) && msg_packet_parse(pkt, sizeof pkt, &msg_rx)) {
 		msg_rx_valid = true;
+		bool store = true, auto_ack = true;
