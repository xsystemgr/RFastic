+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 The RadioFoundry Authors
+// The UART the messenger link (core/messenger/msg_bridge.h) runs on: the MCU's programming-cable UART, where an
+// ESP32 inside the radio is wired. Only built with CONFIG_MESSENGER_LINK.
+#ifndef RT880_LINK_UART_H
+#define RT880_LINK_UART_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+void rt880_link_uart_init(void);				// 38400 8N1, RX interrupt into a ring buffer
+size_t rt880_link_uart_read(uint8_t *buf, size_t max);		// bytes received since the last call, non-blocking
+void rt880_link_uart_write(const uint8_t *buf, size_t len);	// queue and send (may block briefly)
+
+#endif
