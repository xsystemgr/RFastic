diff --git a/core/messenger/tests/msg_link_test.c b/core/messenger/tests/msg_link_test.c
new file mode 100644
index 0000000..1f73cc4
--- /dev/null
+++ b/core/messenger/tests/msg_link_test.c
@@ -0,0 +1,214 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 The RadioFoundry Authors
+// Host test: KISS framing, the host side of the messenger link and the radio-side bridge talking to each other.
+#include <stdio.h>
+#include <string.h>
+#include "messenger/msg_kiss.h"
+#include "messenger/msg_link.h"
+#include "messenger/msg_bridge.h"
+
+static int failures;
+#define CHECK(c) do { if (!(c)) { printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); failures++; } } while (0)
+
+// ---- a fake board --------------------------------------------------------------------------------------------------
+static uint8_t board_tx[MSG_PKT_WIRE_LEN];
+static int board_tx_count;
+static bool board_tx_busy;
+static char board_call[MSG_CALLSIGN_LEN + 1];
+
+static bool fake_tx(void *ctx, const uint8_t p[MSG_PKT_WIRE_LEN])
+{
+	(void)ctx;
+	if (board_tx_busy) {
+		return false;
+	}
+	memcpy(board_tx, p, MSG_PKT_WIRE_LEN);
+	board_tx_count++;
+	board_tx_busy = true;
+	return true;
+}
+
+static void fake_call(void *ctx, const char *c)
+{
+	(void)ctx;
+	strncpy(board_call, c, MSG_CALLSIGN_LEN);
+}
+
+static uint8_t fake_caps(void *ctx)
+{
+	(void)ctx;
+	return MSG_LINK_CAP_TX | MSG_LINK_CAP_LBT;
+}
+
+// Pull every frame the bridge has for the host and decode the events.
+static int host_read(msg_link_event_t *evs, int max)
+{
+	static msg_kiss_rx_t krx;
+	static bool init;
+	if (!init) {
+		msg_kiss_rx_init(&krx);
+		init = true;
+	}
+	uint8_t buf[256];
+	int n = 0;
+	size_t got;
+	while ((got = msg_bridge_output(buf, sizeof buf)) > 0) {
+		for (size_t i = 0; i < got; i++) {
+			uint16_t fl = msg_kiss_rx_byte(&krx, buf[i]);
+			if (fl > 0 && n < max && msg_link_decode_event(krx.buf, fl, &evs[n])) {
+				n++;
+			}
+		}
+	}
+	return n;
+}
+
+static void test_kiss(void)
+{
+	// Every byte value, including FEND/FESC, survives a round trip.
+	uint8_t data[256];
+	for (int i = 0; i < 100; i++) {
+		data[i] = (uint8_t)(i * 37u);
+	}
+	data[3] = MSG_KISS_FEND;
+	data[4] = MSG_KISS_FESC;
+	uint8_t enc[MSG_KISS_ENCODED_MAX(100)];
+	size_t n = msg_kiss_encode(enc, sizeof enc, 0x10, NULL, 0, data, 100);
+	CHECK(n > 102);
+	CHECK(enc[0] == MSG_KISS_FEND && enc[n - 1] == MSG_KISS_FEND);
+	for (size_t i = 1; i + 1 < n; i++) {
+		CHECK(enc[i] != MSG_KISS_FEND);
+	}
+	msg_kiss_rx_t rx;
+	msg_kiss_rx_init(&rx);
+	CHECK(msg_kiss_rx_byte(&rx, 0x55) == 0);	// noise before the first FEND is ignored
+	uint16_t got = 0;
+	for (size_t i = 0; i < n; i++) {
+		uint16_t r = msg_kiss_rx_byte(&rx, enc[i]);
+		if (r) {
+			got = r;
+		}
+	}
+	CHECK(got == 101);
+	CHECK(rx.buf[0] == 0x10 && memcmp(&rx.buf[1], data, 100) == 0);
+	// Too small an output buffer writes nothing useful.
+	CHECK(msg_kiss_encode(enc, 10, 0x10, NULL, 0, data, 100) == 0);
+	// A bad escape drops the frame.
+	msg_kiss_rx_init(&rx);
+	uint8_t bad[] = { MSG_KISS_FEND, 0x10, MSG_KISS_FESC, 0x01, 0x02, MSG_KISS_FEND };
+	got = 0;
+	for (size_t i = 0; i < sizeof bad; i++) {
+		got |= msg_kiss_rx_byte(&rx, bad[i]);
+	}
+	CHECK(got == 0);
+}
+
+static void test_bridge(void)
+{
+	msg_bridge_ops_t ops = { .tx_packet = fake_tx, .set_call = fake_call, .caps = fake_caps };
+	msg_bridge_init(&ops, "RT880");
+	msg_link_event_t ev[8];
+	uint8_t f[MSG_LINK_FRAME_MAX];
+	uint8_t pkt[MSG_PKT_WIRE_LEN];
+	msg_packet_build_text(pkt, sizeof pkt, 0x0102, "SV4QXF", "hi", 3);
+
+	// Detached: nothing is queued for a host that isn't there; the radio ACKs and stores by itself.
+	CHECK(!msg_bridge_attached());
+	CHECK(!msg_bridge_suppress_auto_ack() && msg_bridge_local_store());
+	msg_bridge_on_rx(pkt, -80);
+	CHECK(host_read(ev, 8) == 0);
+
+	// HELLO attaches and is answered with version, mode, caps, call.
+	size_t n = msg_link_encode_hello(f, sizeof f);
+	msg_bridge_feed(f, n, 1000);
+	CHECK(msg_bridge_attached() && msg_bridge_suppress_auto_ack() && msg_bridge_local_store());
+	CHECK(host_read(ev, 8) == 1);
+	CHECK(ev[0].kind == MSG_LINK_EVENT_HELLO && ev[0].version == MSG_LINK_VERSION);
+	CHECK(ev[0].mode == MSG_LINK_MODE_DEFAULT && ev[0].caps == (MSG_LINK_CAP_TX | MSG_LINK_CAP_LBT));
+	CHECK(strcmp(ev[0].call, "RT880") == 0);
+
+	// SET_CALL reaches the board; SET_MODE without STORE stops local filing.
+	n = msg_link_encode_set_call(f, sizeof f, "SV4QXF");
+	msg_bridge_feed(f, n, 1100);
+	CHECK(strcmp(board_call, "SV4QXF") == 0);
+	n = msg_link_encode_set_mode(f, sizeof f, MSG_LINK_MODE_BRIDGE);
+	msg_bridge_feed(f, n, 1200);
+	CHECK(!msg_bridge_local_store());
+	CHECK(host_read(ev, 8) == 1 && ev[0].kind == MSG_LINK_EVENT_HELLO && strcmp(ev[0].call, "SV4QXF") == 0);
+
+	// Received frames go to the host with their RSSI, byte for byte.
+	msg_bridge_on_rx(pkt, -97);
+	CHECK(host_read(ev, 8) == 1);
+	CHECK(ev[0].kind == MSG_LINK_EVENT_RX && ev[0].rssi == -97 && memcmp(ev[0].packet, pkt, sizeof pkt) == 0);
+
+	// A transmit request is validated and handed to the board; a second one while busy is QUEUE_FULL.
+	n = msg_link_encode_tx(f, sizeof f, pkt);
+	msg_bridge_feed(f, n, 1300);
+	CHECK(board_tx_count == 1 && memcmp(board_tx, pkt, sizeof pkt) == 0);
+	msg_bridge_feed(f, n, 1310);
+	CHECK(board_tx_count == 1);
+	CHECK(host_read(ev, 8) == 1 && ev[0].kind == MSG_LINK_EVENT_TX_RESULT && ev[0].result == MSG_LINK_TX_QUEUE_FULL);
+	board_tx_busy = false;
+	msg_bridge_on_tx_done(pkt, MSG_LINK_TX_OK);
+	CHECK(host_read(ev, 8) == 1);
+	CHECK(ev[0].kind == MSG_LINK_EVENT_TX_RESULT && ev[0].tx_id == 0x0102 && ev[0].tx_type == MSG_PKT_TYPE_TEXT);
+	CHECK(ev[0].result == MSG_LINK_TX_OK);
+
+	// A corrupted packet is refused with BAD_PACKET and never reaches the board.
+	uint8_t bad[MSG_PKT_WIRE_LEN];
+	memcpy(bad, pkt, sizeof bad);
+	bad[30] ^= 0x40;
+	n = msg_link_encode_tx(f, sizeof f, bad);
+	msg_bridge_feed(f, n, 1400);
+	CHECK(board_tx_count == 1);
+	CHECK(host_read(ev, 8) == 1 && ev[0].kind == MSG_LINK_EVENT_ERROR && ev[0].error == MSG_LINK_ERR_BAD_PACKET);
+
+	// Byte-at-a-time feeding (a UART ISR) works the same.
+	n = msg_link_encode_keepalive(f, sizeof f);
+	for (size_t i = 0; i < n; i++) {
+		msg_bridge_feed(&f[i], 1, 5000);
+	}
+	CHECK(host_read(ev, 8) == 0);
+
+	// The output never splits a frame: a too-small read gets nothing, a big one gets whole frames.
+	msg_bridge_on_rx(pkt, -50);
+	uint8_t small[20];
+	CHECK(msg_bridge_output(small, sizeof small) == 0);
+	CHECK(host_read(ev, 8) == 1 && ev[0].kind == MSG_LINK_EVENT_RX);
+
+	// A full queue drops (and counts) instead of corrupting.
+	for (int i = 0; i < 20; i++) {
+		msg_bridge_on_rx(pkt, -60);
+	}
+	CHECK(msg_bridge_dropped() > 0);
+	int got = host_read(ev, 8);
+	CHECK(got >= 3);
+	for (int i = 0; i < got; i++) {
+		CHECK(ev[i].kind == MSG_LINK_EVENT_RX && memcmp(ev[i].packet, pkt, sizeof pkt) == 0);
+	}
+
+	// Silence for longer than the timeout detaches: the radio goes back to standalone behavior.
+	msg_bridge_tick(5000 + MSG_LINK_TIMEOUT_MS - 1);
+	CHECK(msg_bridge_attached());
+	msg_bridge_tick(5000 + MSG_LINK_TIMEOUT_MS + 1);
+	CHECK(!msg_bridge_attached() && !msg_bridge_suppress_auto_ack() && msg_bridge_local_store());
+
+	// Frames for another KISS port (an APRS TNC on port 0) are not the bridge's.
+	uint8_t other[MSG_LINK_FRAME_MAX];
+	n = msg_kiss_encode(other, sizeof other, 0x00, NULL, 0, pkt, sizeof pkt);
+	msg_bridge_feed(other, n, 30000);
+	CHECK(!msg_bridge_attached() && board_tx_count == 1);
+}
+
+int main(void)
+{
+	test_kiss();
+	test_bridge();
+	if (failures) {
+		printf("msg_link test: %d failure(s)\n", failures);
+		return 1;
+	}
+	printf("msg_link test: OK (KISS round-trip/escape/errors, HELLO/SET_CALL/SET_MODE, RX events, TX + QUEUE_FULL, "
+		"BAD_PACKET, whole-frame output, overflow, timeout, foreign port)\n");
+	return 0;
+}
diff --git a/core/messenger/tests/msg_mesh_test.c b/core/messenger/tests/msg_mesh_test.c
new file mode 100644
index 0000000..a43d8df
--- /dev/null
+++ b/core/messenger/tests/msg_mesh_test.c
@@ -0,0 +1,259 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 The RadioFoundry Authors
+// Host test: a simulated network of mesh nodes on one shared channel. Each node hears only the nodes in its range
+// table; a frame sent at time t arrives at t + AIR_MS. Checks relaying, dedup, ACKs over relays, retries and
+// suppression.
+#include <stdio.h>
+#include <string.h>
+#include "messenger/msg_mesh.h"
+
+static int failures;
+#define CHECK(c) do { if (!(c)) { printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); failures++; } } while (0)
+
+#define NODES	4
+#define AIR_MS	900u
+#define QMAX	64
+
+typedef struct {
+	int idx;
+	msg_mesh_t mesh;
+	int delivered;
+	char last_text[MSG_TEXT_LEN + 1];
+	char last_from[MSG_CALLSIGN_LEN + 1];
+	uint8_t last_hops;
+	msg_mesh_status_t last_status;
+	uint16_t last_status_id;
+	int sent;
+} node_t;
+
+static node_t nodes[NODES];
+static bool hears[NODES][NODES];	// hears[a][b]: a receives what b sends
+static uint32_t now;
+static uint32_t rng = 12345;
+static int drop_next_from = -1;	// drop the next frame this node sends (nobody hears it)
+
+typedef struct { uint8_t pkt[MSG_PKT_WIRE_LEN]; int src; uint32_t at; } air_t;
+static air_t air[QMAX];
+static int air_n;
+
+static uint32_t fake_rand(void *ctx)
+{
+	(void)ctx;
+	rng = rng * 1103515245u + 12345u;
+	return rng >> 8;
+}
+
+static void on_send(void *ctx, const uint8_t p[MSG_PKT_WIRE_LEN])
+{
+	node_t *n = ctx;
+	n->sent++;
+	if (drop_next_from == n->idx) {
+		drop_next_from = -1;
+		return;
+	}
+	if (air_n < QMAX) {
+		memcpy(air[air_n].pkt, p, MSG_PKT_WIRE_LEN);
+		air[air_n].src = n->idx;
+		air[air_n].at = now + AIR_MS;
+		air_n++;
+	}
+}
+
+static void on_deliver(void *ctx, const msg_packet_t *p, int8_t rssi, uint8_t hops)
+{
+	(void)rssi;
+	node_t *n = ctx;
+	n->delivered++;
+	strcpy(n->last_text, (const char *)p->payload);
+	strcpy(n->last_from, p->from);
+	n->last_hops = hops;
+}
+
+static void on_status(void *ctx, uint16_t id, msg_mesh_status_t st)
+{
+	node_t *n = ctx;
+	n->last_status = st;
+	n->last_status_id = id;
+}
+
+static void setup(const char *const *calls, int count)
+{
+	memset(nodes, 0, sizeof nodes);
+	memset(hears, 0, sizeof hears);
+	air_n = 0;
+	now = 1000;
+	for (int i = 0; i < count; i++) {
+		nodes[i].idx = i;
+		msg_mesh_cfg_t cfg;
+		msg_mesh_default_cfg(&cfg, calls[i]);
+		msg_mesh_ops_t ops = { .send = on_send, .deliver = on_deliver, .status = on_status, .rand = fake_rand,
+			.ctx = &nodes[i] };
+		msg_mesh_init(&nodes[i].mesh, &cfg, &ops);
+	}
+}
+
+static void link(int a, int b)
+{
+	hears[a][b] = hears[b][a] = true;
+}
+
+// Advance simulated time in 10 ms steps, delivering frames and running timers.
+static void run(uint32_t ms, int count)
+{
+	for (uint32_t t = 0; t < ms; t += 10) {
+		now += 10;
+		for (int i = 0; i < air_n;) {
+			if ((int32_t)(now - air[i].at) >= 0) {
+				air_t f = air[i];
+				memmove(&air[i], &air[i + 1], (size_t)(air_n - i - 1) * sizeof air[0]);
+				air_n--;
+				for (int r = 0; r < count; r++) {
+					if (r != f.src && hears[r][f.src]) {
+						msg_mesh_on_rx(&nodes[r].mesh, f.pkt, -90, now);
+					}
+				}
+			} else {
+				i++;
+			}
+		}
+		for (int i = 0; i < count; i++) {
+			msg_mesh_tick(&nodes[i].mesh, now);
+		}
+	}
+}
+
+// A - B - C in a line: A and C can't hear each other.
+static void test_direct_over_relay(void)
+{
+	const char *calls[] = { "AAA", "BBB", "CCC" };
+	setup(calls, 3);
+	link(0, 1);
+	link(1, 2);
+	uint16_t id;
+	CHECK(msg_mesh_send_text(&nodes[0].mesh, "CCC", "hello C", now, &id));
+	run(20000, 3);
+	CHECK(nodes[2].delivered == 1 && strcmp(nodes[2].last_text, "hello C") == 0);
+	CHECK(strcmp(nodes[2].last_from, "AAA") == 0 && nodes[2].last_hops == 1);
+	CHECK(nodes[1].delivered == 0);			// B relays but a message to C isn't B's
+	CHECK(nodes[0].last_status == MSG_MESH_ST_ACKED && nodes[0].last_status_id == id);
+	CHECK(nodes[1].mesh.relayed == 2);		// the TEXT one way and the ACK back
+	CHECK(nodes[0].sent == 1);			// no retry was needed
+}
+
+// Broadcast in a line: everyone gets it exactly once; A's neighbor ACKs it, the far node doesn't.
+static void test_broadcast(void)
+{
+	const char *calls[] = { "AAA", "BBB", "CCC" };
+	setup(calls, 3);
+	link(0, 1);
+	link(1, 2);
+	CHECK(msg_mesh_send_text(&nodes[0].mesh, NULL, "to all", now, NULL));
+	run(20000, 3);
+	CHECK(nodes[1].delivered == 1 && nodes[2].delivered == 1);
+	CHECK(nodes[2].last_hops == 1);
+	CHECK(nodes[0].last_status == MSG_MESH_ST_ACKED);	// B's first-hand ACK
+	// C heard it relayed (TTL 3 -> 2): no ACK from C, only its own relay hop (2 -> 1).
+	CHECK(nodes[2].sent == 1 && nodes[2].mesh.relayed == 1);
+}
+
+// The first copy of the TEXT is lost: A retries, C gets it once.
+static void test_retry(void)
+{
+	const char *calls[] = { "AAA", "BBB" };
+	setup(calls, 2);
+	link(0, 1);
+	drop_next_from = 0;
+	CHECK(msg_mesh_send_text(&nodes[0].mesh, "BBB", "again", now, NULL));
+	run(30000, 2);
+	CHECK(nodes[1].delivered == 1);
+	CHECK(nodes[0].sent == 2);
+	CHECK(nodes[0].last_status == MSG_MESH_ST_ACKED);
+}
+
+// The ACK is lost: A retries, B dedups (no second delivery) but ACKs again.
+static void test_lost_ack(void)
+{
+	const char *calls[] = { "AAA", "BBB" };
+	setup(calls, 2);
+	link(0, 1);
+	CHECK(msg_mesh_send_text(&nodes[0].mesh, "BBB", "ack lost", now, NULL));
+	run(500, 2);
+	drop_next_from = 1;				// B's first ACK goes nowhere
+	run(30000, 2);
+	CHECK(nodes[1].delivered == 1);
+	CHECK(nodes[1].mesh.duplicates == 1);
+	CHECK(nodes[0].last_status == MSG_MESH_ST_ACKED);
+}
+
+// Nobody there: a direct message ends FAILED after 1 + retries tries.
+static void test_failed(void)
+{
+	const char *calls[] = { "AAA", "BBB" };
+	setup(calls, 2);
+	CHECK(msg_mesh_send_text(&nodes[0].mesh, "BBB", "anyone?", now, NULL));
+	run(60000, 2);
+	CHECK(nodes[0].sent == 3 && nodes[0].last_status == MSG_MESH_ST_FAILED);
+}
+
+// A diamond A - {B, C} - D: B and C both hear A's broadcast; usually whichever relays first suppresses the other.
+// D must deliver exactly once every time; over many random seeds, suppression must save a burst most of the time.
+static void test_suppression(void)
+{
+	const char *calls[] = { "AAA", "BBB", "CCC", "DDD" };
+	int saved = 0;
+	for (uint32_t seed = 1; seed <= 40; seed++) {
+		rng = seed * 7919u;
+		setup(calls, 4);
+		link(0, 1);
+		link(0, 2);
+		link(1, 2);
+		link(1, 3);
+		link(2, 3);
+		nodes[0].mesh.cfg.ttl = 2;		// one relay hop is enough here
+		nodes[0].mesh.cfg.ack_broadcast = false;
+		nodes[1].mesh.cfg.ack_broadcast = false;
+		nodes[2].mesh.cfg.ack_broadcast = false;
+		nodes[3].mesh.cfg.ack_broadcast = false;
+		CHECK(msg_mesh_send_text(&nodes[0].mesh, NULL, "diamond", now, NULL));
+		run(20000, 4);
+		CHECK(nodes[3].delivered == 1);
+		if (nodes[1].mesh.suppressed + nodes[2].mesh.suppressed >= 1) {
+			saved++;
+		}
+	}
+	printf("suppression saved a burst in %d of 40 runs\n", saved);
+	CHECK(saved >= 20);
+}
+
+// Malformed or own frames are ignored.
+static void test_ignore(void)
+{
+	const char *calls[] = { "AAA" };
+	setup(calls, 1);
+	uint8_t p[MSG_PKT_WIRE_LEN];
+	msg_packet_build_text(p, sizeof p, 7, "AAA", "me", 3);
+	msg_mesh_on_rx(&nodes[0].mesh, p, -50, now);
+	CHECK(nodes[0].delivered == 0 && nodes[0].sent == 0);
+	msg_packet_build_text(p, sizeof p, 8, "ZZZ", "x", 3);
+	p[40] ^= 1;
+	msg_mesh_on_rx(&nodes[0].mesh, p, -50, now);
+	CHECK(nodes[0].delivered == 0);
+}
+
+int main(void)
+{
+	test_direct_over_relay();
+	test_broadcast();
+	test_retry();
+	test_lost_ack();
+	test_failed();
+	test_suppression();
+	test_ignore();
+	if (failures) {
+		printf("msg_mesh test: %d failure(s)\n", failures);
+		return 1;
+	}
+	printf("msg_mesh test: OK (direct over a relay with ACK back, broadcast, retry, lost ACK, failure, "
+		"relay suppression, ignored frames)\n");
+	return 0;
+}
diff --git a/docs/spec/messenger-link.md b/docs/spec/messenger-link.md
new file mode 100644
index 0000000..c9f8866
--- /dev/null
+++ b/docs/spec/messenger-link.md
@@ -0,0 +1,133 @@
+<!-- SPDX-License-Identifier: MIT -->
+<!-- Copyright (c) 2026 The RadioFoundry Authors -->
+
+# Messenger link: a GGM2 modem on a UART
+
+Version 1. Status: implemented and host-tested on both ends, not yet tried on hardware.
+
+A radio with a BK4819 FSK modem already sends and receives GGM2 frames (the GOGUFW-compatible analog messenger,
+[msg_packet.h](../../core/messenger/msg_packet.h)). The messenger link offers that modem to a host on the radio's UART, the
+one the programming cable uses. The host is usually a small ESP32 wired inside the radio, but a PC on a cable works
+too. With the link, the radio only moves GGM2 packets on and off the air. The host owns everything else: relaying,
+dedup, ACKs, retries, the message log, and the phone UI.
+
+The over-the-air format does not change. A radio with a host still talks to a plain GOGUFW radio, and the plain radio
+sees ordinary GGM2 TEXT and ACK frames.
+
+```
+phone ──WiFi/BLE──► ESP32 (mesh host) ──UART 38400 8N1──► radio MCU ──SPI──► BK4819 ──► 1200-baud FSK, GGM2
+```
+
+## 1. Framing
+
+The link uses KISS framing, the public TNC host protocol. `FEND 0xC0` starts and ends every frame. Inside a frame,
+`0xC0` is sent as `0xDB 0xDC` and `0xDB` as `0xDB 0xDD`. The first byte of a frame is the KISS command byte: the high
+nibble is the port and the low nibble is the command.
+
+The link uses **KISS port 1**. Port 0 stays free for an APRS TNC on radios that have one, so both can share the UART.
+A receiver ignores frames for other ports.
+
+| Command byte | Meaning |
+|---|---|
+| `0x10` | data (port 1, command 0): one GGM2 packet, host to radio |
+| `0x16` | SetHardware (port 1, command 6): control, followed by an op byte |
+
+## 2. Host to radio
+
+| Frame | Meaning |
+|---|---|
+| `0x10` + 94 bytes | Transmit this GGM2 packet on the current channel. The radio checks length, magic, version and CRC first. |
+| `0x16 0x01` + version | HELLO. The radio enters bridge mode with the default mode and answers with a HELLO reply. |
+| `0x16 0x02` + 1..8 bytes | SET_CALL: the radio's own callsign, for its UI and for any frame it builds itself. |
+| `0x16 0x03` | KEEPALIVE. Gets no reply. Every frame from the host counts as a keepalive. |
+| `0x16 0x04` + mode | SET_MODE. Answered with a HELLO reply. |
+
+Mode bits:
+
+| Bit | Name | When set |
+|---|---|---|
+| 0 | BRIDGE | The radio sends no ACK of its own for received TEXT. The host does it. |
+| 1 | STORE | The radio still files received TEXT in its own inbox, so its screen shows them. |
+
+HELLO sets BRIDGE and STORE.
+
+## 3. Radio to host
+
+| Frame | Meaning |
+|---|---|
+| `0x16 0x80` + rssi (int8, dBm) + 94 bytes | A valid GGM2 frame was received: the packet as it came off the air. |
+| `0x16 0x81` + version + mode + caps + call (8 bytes, zero padded) | HELLO reply. |
+| `0x16 0x82` + type + id (LE16) + result | Transmit result for a data frame. |
+| `0x16 0x8F` + op + error | Request refused. op is `0x10` for a data frame, otherwise the control op. |
+
+The radio reports every valid frame, whatever its type or destination. Filtering is the host's job.
+
+Capability bits: `0x01` TX (the radio can transmit here) and `0x02` LBT (it waits for a clear channel before keying
+up).
+
+Transmit results: `0` OK, `1` BUSY (the channel stayed busy), `2` REFUSED (no TX here: out of a TX band, receive-only,
+TX inhibited), `3` QUEUE_FULL (a transmit is already pending: send again after its result), `4` TIMEOUT (the burst
+never finished).
+
+Errors: `1` BAD_PACKET, `2` BAD_OP, `3` BAD_LEN.
+
+## 4. Session
+
+1. The host sends HELLO until it gets a HELLO reply (every 3 s), then sends SET_CALL if the reply's callsign is not
+   its own.
+2. The host keeps one transmit in flight. It sends the next data frame only after the previous one's result, or 5 s
+   without a result. On QUEUE_FULL it retries after about 300 ms. On BUSY it retries a few times after a random 0.5 to
+   2 s.
+3. The host sends something at least every 5 s. It repeats HELLO every 30 s and treats a missing reply (3 s) as the
+   radio being gone.
+4. The radio leaves bridge mode after **15 s** with no frame from the host. It then ACKs and files messages on its own
+   again, so a host that crashes or loses power never leaves the radio deaf.
+5. While no host is attached, the radio queues nothing for it.
+
+The radio sends its output in whole frames only, so frames from different tasks never interleave on the wire. If its
+output queue is full, it drops a frame whole and counts it rather than truncating it.
+
+## 5. Mesh (host side)
+
+The host runs the mesh ([msg_mesh.h](../../core/messenger/msg_mesh.h)) on the plain GGM2 fields. It adds no new bytes.
+
+- A frame's identity is `(from, id, type)`, remembered for 120 s. A frame already seen is a duplicate.
+- `hops = ttl_init - ttl_remain`. A first-hand frame has `hops = 0`.
+- **TEXT to us:** delivered once and ACKed with `ttl = hops + 1`, so the ACK can travel back over the same number of
+  relays. A duplicate TEXT to us is ACKed again, because the sender is retrying and our first ACK may have been lost,
+  but it is not delivered twice.
+- **TEXT to ALL:** delivered once. It is ACKed with `ttl = 1` only when heard first-hand, which is what a plain GOGUFW
+  radio does. That ACK marks a broadcast as "heard by someone".
+- **Relay:** TEXT not addressed to us, and ACK not addressed to us, are forwarded while `ttl_remain > 1`. The copy
+  carries `ttl_remain - 1` (the CRC is recomputed) and goes out after a random delay of 200 ms plus a random slot of
+  1.2 s (4 slots) plus up to 99 ms of jitter. A slot is longer than one burst (about 0.9 s on air), so the earliest
+  relay is usually heard before the others fire. A node that hears another copy of a frame it is about to relay
+  cancels its own copy.
+- PING, PONG and WAKE are neighbor-only and never relayed.
+- **Own TEXT:** sent with `ttl = 3` by default, which is GOGUFW's default. A direct TEXT is retried twice (three tries
+  in all) with the same id until an ACK comes back. The ACK window is 3 s + 4.5 s per hop of budget, plus a random
+  0.2 to 0.8 s before each retry. A broadcast is not retried: after one window it is "no ack" unless some neighbor
+  ACKed it.
+- A direct TEXT carries the destination callsign in `to`. A plain GOGUFW radio shows any TEXT it receives, so direct
+  messages are private by convention only. Nothing on the air is encrypted.
+
+### What a plain GOGUFW radio sees
+
+- TEXT from a host node: an ordinary message (`to` = ALL or a callsign).
+- Relayed TEXT: the same message, once, with the original sender's callsign, because its `(from, id)` is unchanged.
+  Whether it suppresses the duplicate depends on its own dedup.
+- ACK with `ttl > 1`: an ordinary ACK.
+
+## 6. Timing at 1200 baud
+
+One GGM2 frame is 100 FIFO bytes plus a 16-byte preamble and sync, about 0.8 s, plus about 80 ms of keying and
+settling: about 0.9 s per burst. A direct message over one relay with its ACK back is four bursts plus two relay
+delays, typically 5 to 8 s.
+
+## 7. Not in version 1
+
+- Listen-before-talk on the radio side (the capability bit exists).
+- BLE transport on the host (WiFi access point and USB serial only for now).
+- Fragmentation of texts longer than 64 bytes.
+- Any encryption. On amateur bands, encryption that obscures meaning is not allowed, so if it ever appears it must be
+  opt-in and off by default.
