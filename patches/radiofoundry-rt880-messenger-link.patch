index abd1bf3..5591108 100644
--- a/boards/rt880/radio.c
+++ b/boards/rt880/radio.c
@@ -16,6 +16,11 @@
 #include "messenger/msg_store.h"
 #include "messenger/msg_radio.h"
 #endif
+#if CONFIG_MESSENGER && CONFIG_MESSENGER_LINK
+#include "messenger/msg_bridge.h"
