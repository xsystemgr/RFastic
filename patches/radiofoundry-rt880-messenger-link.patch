diff --git a/boards/rt880/link_uart.c b/boards/rt880/link_uart.c
new file mode 100644
index 0000000..d386057
--- /dev/null
+++ b/boards/rt880/link_uart.c
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 The RadioFoundry Authors
+// Messenger link UART (link_uart.h). NOT WRITTEN YET: the programming-cable pins and the USART instance they mux to
+// still have to be traced on the board (continuity from the K-plug contacts to the AT32F423, then the datasheet's
+// alternate-function table). Until then these are inert: the link never attaches and the radio stays a standalone
+// messenger. What the real driver needs:
+//   - 38400 8N1 on that USART, clocked from its APB bus
+//   - an RX-not-empty interrupt filling a ring of >= 256 bytes: the link is serviced every 25 ms from the radio poll,
+//     and 25 ms at 38400 baud is 96 bytes
+//   - TX may be polled (the largest link frame is under 200 bytes, ~50 ms)
+#include "config.h"
+#if CONFIG_MESSENGER && CONFIG_MESSENGER_LINK
+#include "link_uart.h"
+
+void rt880_link_uart_init(void)
+{
+}
+
+size_t rt880_link_uart_read(uint8_t *buf, size_t max)
+{
+	(void)buf;
+	(void)max;
+	return 0;
+}
+
+void rt880_link_uart_write(const uint8_t *buf, size_t len)
+{
+	(void)buf;
+	(void)len;
+}
+#endif
diff --git a/boards/rt880/link_uart.h b/boards/rt880/link_uart.h
